              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ProgressUpdateStream\": \"U+ij$ .WiX#\",\n  \"MigrationTaskName\": \"4\",\n  \"CreatedArtifactName\": \"arn:ka-kw:a:::l59q)xmNR7\",\n  \"DryRun\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
